{
  "name": "csq",
  "version": "4.2.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20 <21"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "prisma": {
    "schema": "packages/core/prisma/schema.prisma"
  },
  "scripts": {
    "dev": "npm run dev -w apps/dashboard",
    "build": "npm run db:generate -w packages/core && npm run build -w apps/dashboard",
    "start": "npm run db:deploy -w packages/core && npm run start -w apps/dashboard",
    "start:worker": "npm run db:deploy -w packages/core && npm run start -w apps/worker",
    "build:api": "npm run build -w apps/api",
    "start:api": "npm run db:deploy -w packages/core && npm run start -w apps/api",
    "lint": "npm run lint -w apps/dashboard",
    "check:encoding": "node scripts/check-encoding.mjs",
    "check:openapi": "tsx scripts/self-check-openapi.ts",
    "check:alerts": "tsx scripts/alert-check.ts",
    "check:kpi": "tsx scripts/self-check-kpi.ts",
    "check:vision": "tsx scripts/self-check-vision.ts",
    "check:rls": "tsx scripts/self-check-rls.ts",
    "check:billing": "tsx scripts/self-check-billing.ts",
    "check:tools": "tsx scripts/self-check-refund-ticket.ts",
    "db:migration-checksums": "node scripts/migration-checksums.mjs",
    "db:migrate": "npm run db:migrate -w packages/core",
    "db:seed": "npm run db:seed -w packages/core",
    "demo:reset": "npm run demo:reset -w packages/core"
  }
}
