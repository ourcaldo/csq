{
  "name": "csq",
  "version": "4.0.0",
  "private": true,
  "engines": {
    "node": ">=20 <21"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "prisma": {
    "schema": "apps/dashboard/prisma/schema.prisma"
  },
  "scripts": {
    "dev": "npm run dev -w apps/dashboard",
    "build": "npm run prisma:generate -w apps/dashboard && npm run build -w apps/dashboard",
    "start": "npm run db:deploy -w apps/dashboard && npm run start -w apps/dashboard",
    "lint": "npm run lint -w apps/dashboard",
    "check:encoding": "node scripts/check-encoding.mjs",
    "db:migration-checksums": "node scripts/migration-checksums.mjs"
  }
}
