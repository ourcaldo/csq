# ---------------------------------------------------------------
# CSQ production environment (VPS / Docker Compose).
# Copy to .env.production and fill in. Never commit the filled file.
# ---------------------------------------------------------------

# -- Container images (prebuild in CI, push to a registry) --
CSQ_APP_IMAGE=registry.example/csq/app:latest
CSQ_API_IMAGE=registry.example/csq/api:latest
CSQ_WORKER_IMAGE=registry.example/csq/worker:latest
CSQ_NGINX_IMAGE=registry.example/csq/nginx:latest

# -- Postgres: two supported modes (pick ONE) --
# Mode A (self-hosted): keep POSTGRES_* and the compose `postgres` service;
# DATABASE_URL points at postgres:5432 on the compose network.
# Mode B (managed, e.g. Neon): set DATABASE_URL (pooled) and
# DATABASE_URL_UNPOOLED (direct, used by `prisma migrate deploy`) to the
# managed endpoints and remove the `postgres` service from the stack.
# pgvector is required in both modes (pgvector image locally; built into Neon).
POSTGRES_DB=umkm_prod
POSTGRES_USER=umkm
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql://umkm:change-me-strong-password@postgres:5432/umkm_prod?schema=public
DATABASE_URL_UNPOOLED=postgresql://umkm:change-me-strong-password@postgres:5432/umkm_prod?schema=public

# -- Auth (NextAuth v4, dashboard) --
NEXTAUTH_URL=https://your-domain.example
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# -- API service (monorepo) --
# Public origin. Nginx routes /api/v1, /api/media and /api/webhooks to api.
API_URL=https://your-domain.example
# Shared service token: the dashboard BFF sends it, the api accepts it.
API_SERVICE_TOKEN=generate-a-long-random-token
# Signs the /api/v1 user access JWTs.
API_JWT_SECRET=generate-with-openssl-rand-base64-32

# -- TLS --
CERT_DOMAIN=your-domain.example

# -- WhatsApp Cloud API (official; ToS-safe). Graph API v25.0. --
# WHATSAPP_TOKEN, WHATSAPP_PHONE_NUMBER_ID and WHATSAPP_BUSINESS_ACCOUNT_ID
# are entered by the owner in the dashboard and stored in Channel.config.
# WHATSAPP_APP_SECRET and WHATSAPP_VERIFY_TOKEN are app-level env for the api
# webhook: one Meta app, one callback URL, all numbers. Per-channel tokens
# are legacy only.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_API_VERSION=v25.0

# -- Google Sheets (OAuth) --
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.example/api/import/sheets/callback

# -- LLM provider (any OpenAI-compatible endpoint) --
# Base URL WITHOUT the trailing /v1 (the app appends it). Examples:
#   OpenAI:     https://api.openai.com
#   Groq:       https://api.groq.com/openai
# One key serves the agent chat loop, scenario AI node, and embeddings.
LLM_API_KEY=
LLM_BASE_URL=
LLM_CHAT_MODEL=
LLM_EMBEDDING_MODEL=
LLM_EMBEDDING_DIM=1024
SCENARIO_SCHEDULE_TZ=Asia/Jakarta
KNOWLEDGE_SIMILARITY_THRESHOLD=0.5

# -- WhatsApp Cloud API approved templates (G7/G1) --
# Required to message a customer outside the 24h window. Pre-approve in Meta
# Business Manager, then set the exact names here.
WHATSAPP_APPROVAL_TEMPLATE=
WHATSAPP_AGENT_FALLBACK_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=id

# -- Alerting cron (npm run check:alerts) --
# Schedule every 5 minutes on the host or in a scheduler. The worker health
# listener is published on 127.0.0.1:10000; nginx never proxies it.
ALERT_WEBHOOK_URL=
DASHBOARD_URL=https://your-domain.example
WORKER_URL=http://127.0.0.1:10000
