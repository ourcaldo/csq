# Database (pgvector-enabled Postgres). Dev: pgvector/pgvector:pg16 via docker-compose.dev.yml.
# DATABASE_URL is the pooled connection (app runtime). DATABASE_URL_UNPOOLED is
# the direct connection Prisma uses for migrations (schema.prisma directUrl).
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Auth (NextAuth v4)
NEXTAUTH_URL=
NEXTAUTH_SECRET=

# WhatsApp Cloud API (official; ToS-safe). Graph API v25.0.
# NOTE: WHATSAPP_TOKEN, WHATSAPP_PHONE_NUMBER_ID, WHATSAPP_VERIFY_TOKEN,
# WHATSAPP_BUSINESS_ACCOUNT_ID, and WHATSAPP_API_VERSION are entered by the
# store owner through the dashboard UI and stored in Channel.config (DB) —
# the app does NOT read them from env. They are commented out below for
# operator reference only. WHATSAPP_APP_SECRET IS env-consumed (webhook HMAC
# validation fallback) and must be set here.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_API_VERSION=v25.0

# Google Sheets (OAuth). Create a Google Cloud OAuth 2.0 Client ID (Web app),
# enable the Google Sheets API + Google Drive API, and register the redirect
# URI below in the Console. Drive API is required to list the user's sheets.
# Redirect URIs to register (dev + prod):
#   http://localhost:3000/api/import/sheets/callback
#   https://<your-render-domain>/api/import/sheets/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# LLM provider — any OpenAI-compatible endpoint. Base URL WITHOUT the trailing
# /v1 (the app appends it). Examples:
#   OpenAI:     https://api.openai.com
#   Groq:       https://api.groq.com/openai
#   OpenRouter: https://openrouter.ai/api
# LLM_API_KEY is used for the agent chat loop, scenario AI node, and
# embeddings — one provider serves everything.
LLM_API_KEY=
LLM_BASE_URL=
# Chat model the agent loop drives (must support function/tool calling).
LLM_CHAT_MODEL=
# Embeddings (knowledge semantic retrieval). Required for knowledge.search;
# if unset, retrieval degrades to keyword search and knowledge writes skip
# embedding generation (with a warning). Model name is provider-specific —
# set the one your provider serves.
LLM_EMBEDDING_MODEL=
LLM_EMBEDDING_DIM=1024
# Chat model for the scenario "Pesan AI" node (one-shot, tool-less generation;
# services/llm.ts). Defaults to LLM_CHAT_MODEL when unset.
LLM_SCENARIO_MODEL=

# Timezone the scenario ON_SCHEDULE trigger times are interpreted in (the
# target market), independent of the server clock. IANA name.
SCENARIO_SCHEDULE_TZ=Asia/Jakarta
# Cosine similarity threshold for knowledge.search (0-1). Qwen3 similarities on
# Indonesian short-text cluster lower than the old OpenAI default; tune down if
# relevant results are missed, up if false positives appear.
KNOWLEDGE_SIMILARITY_THRESHOLD=0.5

# WhatsApp Cloud API approved templates (G7/G1) — required to message a customer
# outside the 24h customer-service window. Pre-approve them in Meta Business
# Manager and set the exact template names here. When unset and a send falls
# outside the 24h window, the send is skipped + audited (Meta-compliant).
WHATSAPP_APPROVAL_TEMPLATE=
WHATSAPP_AGENT_FALLBACK_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=id
