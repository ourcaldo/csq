# apps/worker environment (OPS-8, PRD 16). The customer-serving runtime:
# WhatsApp sockets, scheduler ticks, campaign engine, outbox drain, channel
# commands.

# Postgres (same database as the dashboard and api).
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# The product API's public origin (public media links in campaign blasts).
API_URL=

# The health listener port (the alert cron probes this; never proxied).
PORT=10000

# LLM provider (agent replies on Baileys inbound, scenario nodes, embeddings).
LLM_API_KEY=
LLM_BASE_URL=
LLM_CHAT_MODEL=
LLM_SCENARIO_MODEL=
LLM_EMBEDDING_MODEL=
LLM_EMBEDDING_DIM=1024

# Approved templates for out-of-24h-window sends.
WHATSAPP_APPROVAL_TEMPLATE=
WHATSAPP_AGENT_FALLBACK_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=id

SCENARIO_SCHEDULE_TZ=Asia/Jakarta
KNOWLEDGE_SIMILARITY_THRESHOLD=0.5
