# apps/admin environment (OPS-8, PRD 16). The platform operator console:
# its own AdminUser auth realm, tenant lifecycle, fleet, audit, plans.

# Postgres (same database; the admin realm reads across tenants).
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Admin auth realm (NextAuth v4). MUST differ from the dashboard's
# NEXTAUTH_SECRET - the two realms must never share a session.
NEXTAUTH_URL=
NEXTAUTH_SECRET=

# Bootstrap the first operator (one-time, prints a one-time password):
#   npm run admin:create -- --email ops@csq.id --name "Operator"
