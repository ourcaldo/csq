# apps/api environment (OPS-8, PRD 16). The product API: /api/v1 token
# realm, Tool Gateway, Meta webhook, media serving.

# Postgres (same database as the dashboard).
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Public origin of this service; the dashboard and worker point their API_URL
# here. Nginx routes /api/v1, /api/media and /api/webhooks to it.
API_URL=

# Comma-separated internal service tokens. The dashboard BFF presents
# API_SERVICE_TOKEN; only listed hashes are accepted.
API_SERVICE_TOKENS=

# Signs the /api/v1 user access JWTs (email + password exchange).
API_JWT_SECRET=

# WhatsApp Cloud API webhook (HMAC validation fallback + app-level verify).
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Approved templates for out-of-24h-window sends (Meta-compliant skip when
# unset).
WHATSAPP_APPROVAL_TEMPLATE=
WHATSAPP_AGENT_FALLBACK_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=id

# LLM provider (scenario AI node runs in this service for webhook-triggered
# scenarios; Cloud API sends are stateless HTTP). Same shape as the
# dashboard's example.
LLM_API_KEY=
LLM_BASE_URL=
LLM_CHAT_MODEL=
LLM_SCENARIO_MODEL=
LLM_EMBEDDING_MODEL=
LLM_EMBEDDING_DIM=1024
# Guardrail layer (PRD 03 amendment 2026-11-13): Google Decisions API,
# authenticated with the same LLM_API_KEY. off | shadow (default, log-only)
# | enforce. The Cloud API webhook runs agent turns here.
GUARD_MODE=shadow

SCENARIO_SCHEDULE_TZ=Asia/Jakarta
KNOWLEDGE_SIMILARITY_THRESHOLD=0.5
