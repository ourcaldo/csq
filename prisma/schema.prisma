// Prisma schema — CSQ.
// Multi-tenant from day one: every model carries tenant_id; all queries filter
// server-side by tenantId (Postgres RLS is the second enforcement layer).
//
// pgvector: "KnowledgeEmbedding.embedding" is declared Unsupported("vector")
// because Prisma has no native vector type. The FIRST migration runs
// `CREATE EXTENSION IF NOT EXISTS vector;` and creates the column; a later
// migration alters it to `vector(1024)` (Fireworks fireworks/qwen3-embedding-8b
// dimension, via the `dimensions` param). All vector reads and writes go
// through src/lib/vector.ts only — never raw SQL elsewhere.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ─────────────────────────── Enums ───────────────────────────

enum UserRole {
  OWNER
  STAFF
}

enum AgentType {
  CUSTOMER_SERVICE
}

enum AgentStatus {
  DRAFT
  ACTIVE
  PAUSED
}

enum ChannelType {
  WHATSAPP
}

enum ChannelProvider {
  CLOUD_API
  BAILEYS
}

enum ChannelStatus {
  CONNECTED
  DISCONNECTED
}

enum DataSourceType {
  MANUAL
  EXCEL
  GOOGLE_SHEETS
}

enum DataSourceStatus {
  ACTIVE
  INACTIVE
  ERROR
}

enum InventorySource {
  MANUAL
  EXCEL
  GOOGLE_SHEETS
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum KnowledgeType {
  FAQ
  POLICY
  BUSINESS_INFO
}

enum MemorySource {
  CONVERSATION
  MANUAL
}

enum MemoryImportance {
  LOW
  MEDIUM
  HIGH
}

enum ApprovalStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageSenderType {
  CUSTOMER
  AGENT
  HUMAN
}

// ─────────────────────────── Models ───────────────────────────

model Tenant {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique
  settings        Json?
  // Per-tenant OpenClaw cell connection (PRD §5/§26: one isolated cell per
  // tenant). Provisioned by the platform at tenant creation. cellStatus is
  // PENDING | PROVISIONED | FAILED. In dev (shared provisioning) these point
  // at a single shared gateway; in production (fleet) at the tenant's own cell.
  openclawCellId  String?
  openclawBaseUrl String?
  openclawToken   String?
  cellStatus      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users               User[]
  agents              Agent[]
  channels            Channel[]
  products            Product[]
  inventory           Inventory[]
  orders              Order[]
  knowledge           Knowledge[]
  knowledgeEmbeddings KnowledgeEmbedding[]
  memories            Memory[]
  inventorySnapshots  InventorySnapshot[]
  dataSources         DataSource[]
  auditLogs           AuditLog[]
  approvals           Approval[]
  conversations       Conversation[]
  contacts            Contact[]
  tags                Tag[]
  messages            Message[]
  orderItems          OrderItem[]
  agentCapabilities   AgentCapability[]
  conversationTags    ConversationTag[]
  sourceRows          SourceRow[]
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         UserRole @default(OWNER)
  tenantId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant                Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedConversations Conversation[] @relation("ConversationAssignee")
  sentMessages          Message[]      @relation("MessageSenderUser")
  resolvedApprovals     Approval[]     @relation("ApprovalResolver")

  @@index([tenantId])
}

model Agent {
  id              String      @id @default(uuid())
  tenantId        String
  name            String
  type            AgentType   @default(CUSTOMER_SERVICE)
  status          AgentStatus @default(DRAFT)
  instructions    String?
  openclawCellId  String?
  openclawAgentId String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  tenant                Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channels              Channel[]
  capabilities          AgentCapability[]
  memories              Memory[]
  auditLogs             AuditLog[]
  approvals             Approval[]
  createdOrders         Order[]           @relation("OrderCreatedByAgent")
  assignedConversations Conversation[]    @relation("ConversationAssigneeAgent")
  sentMessages          Message[]         @relation("MessageSenderAgent")

  @@index([tenantId])
}

model Channel {
  id        String          @id @default(uuid())
  tenantId  String
  agentId   String?
  type      ChannelType     @default(WHATSAPP)
  provider  ChannelProvider @default(CLOUD_API)
  config    Json
  status    ChannelStatus   @default(DISCONNECTED)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent         Agent?         @relation(fields: [agentId], references: [id], onDelete: SetNull)
  conversations Conversation[]

  @@index([tenantId])
}

// Baileys (bring-your-own-number) auth state, stored in the DB so it
// survives restarts without a persistent disk (PRD: always-on, no re-pair
// on restart). Keyed by channelId. creds/keys are the BufferJSON-serialized
// auth state (see src/lib/baileys-auth-db.ts).
model BaileysAuth {
  channelId String   @id
  creds     String?
  keys      String?
  updatedAt DateTime @updatedAt
}

model Product {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  sku         String?
  price       Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventory          Inventory?
  orderItems         OrderItem[]
  inventorySnapshots InventorySnapshot[]

  @@index([tenantId, sku])
  @@index([tenantId, name])
}

model Inventory {
  id        String          @id @default(uuid())
  tenantId  String
  productId String          @unique
  quantity  Int
  source    InventorySource @default(MANUAL)
  sourceRef String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([tenantId, productId])
  @@index([tenantId])
}

// G8: per-source stock snapshot so Tenant.settings.sourcePriority can
// arbitrate conflicts between sources. One row per (tenant, product, source).
// The canonical Inventory row holds the resolved quantity; snapshots hold each
// source's contribution. Resolution lives in src/lib/source-priority.ts.
model InventorySnapshot {
  id        String          @id @default(uuid())
  tenantId  String
  productId String
  source    InventorySource
  quantity  Int
  sourceRef String?
  syncedAt  DateTime        @default(now())
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([tenantId, productId, source])
  @@index([tenantId, productId])
}

model Order {
  id               String      @id @default(uuid())
  tenantId         String
  customerName     String?
  customerPhone    String?
  status           OrderStatus @default(PENDING)
  totalAmount      Decimal     @db.Decimal(14, 2)
  createdByAgentId String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdByAgent Agent?      @relation("OrderCreatedByAgent", fields: [createdByAgentId], references: [id], onDelete: SetNull)
  items          OrderItem[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model OrderItem {
  id        String  @id @default(uuid())
  tenantId  String
  orderId   String
  productId String
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  subtotal  Decimal @db.Decimal(14, 2)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([tenantId])
  @@index([orderId])
  @@index([productId])
}

model Knowledge {
  id        String        @id @default(uuid())
  tenantId  String
  type      KnowledgeType
  title     String
  content   String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  embedding KnowledgeEmbedding?

  @@index([tenantId, type])
}

model KnowledgeEmbedding {
  id          String                 @id @default(uuid())
  tenantId    String
  knowledgeId String                 @unique
  embedding   Unsupported("vector")?
  createdAt   DateTime               @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  knowledge Knowledge @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Memory {
  id         String           @id @default(uuid())
  tenantId   String
  agentId    String
  key        String
  value      String
  source     MemorySource     @default(CONVERSATION)
  importance MemoryImportance @default(MEDIUM)
  createdAt  DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent  Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, agentId, key])
  @@index([tenantId, agentId])
}

model DataSource {
  id         String           @id @default(uuid())
  tenantId   String
  type       DataSourceType
  name       String
  // What kind of data this source holds, e.g. "produk", "cabang", "staff",
  // or a free label. Only "produk" gets structured import into Product/
  // Inventory; everything else is reference data the agent reads via
  // source.search (all columns). Free string so owners can tag any kind of list.
  dataType    String           @default("produk")
  config     Json
  status     DataSourceStatus @default(ACTIVE)
  lastSyncAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceRows SourceRow[]

  @@index([tenantId])
}

// Full parsed rows from an Excel/Google Sheets source, stored on import and on
// each sync so the agent can read inside the sumber data via the `source.search`
// tool — every column, not just the five mapped product fields. Replaced (delete
// + re-insert) on every sync so it stays in sync with the source. `data` is the
// row as { column: value }.
model SourceRow {
  id           String   @id @default(uuid())
  tenantId     String
  dataSourceId String
  rowIndex     Int
  data         Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dataSource DataSource @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)

  @@index([tenantId, dataSourceId])
}

model AgentCapability {
  id               String  @id @default(uuid())
  tenantId         String
  agentId          String
  tool             String
  allowed          Boolean @default(false)
  requiresApproval Boolean @default(false)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent  Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, tool])
  @@index([tenantId])
}

model AuditLog {
  id             String         @id @default(uuid())
  tenantId       String
  agentId        String?
  action         String
  entityType     String
  entityId       String
  beforeValue    Json?
  afterValue     Json?
  approvalStatus ApprovalStatus @default(NONE)
  customerPhone  String?
  createdAt      DateTime       @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent  Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, agentId])
}

model Approval {
  id             String         @id @default(uuid())
  tenantId       String
  agentId        String?
  action         String
  entityType     String
  entityId       String
  proposedBefore Json
  proposedAfter  Json
  params         Json?
  status         ApprovalStatus @default(PENDING)
  resolvedById   String?
  resolvedAt     DateTime?
  createdAt      DateTime       @default(now())
  // G1: routing context so the approval result can be sent back to the
  // originating customer conversation once the owner resolves it.
  conversationId String?
  channelId      String?
  customerPhone  String?

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent        Agent?        @relation(fields: [agentId], references: [id], onDelete: SetNull)
  resolvedBy   User?         @relation("ApprovalResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  conversation Conversation? @relation("ApprovalConversation", fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([conversationId])
}

model Conversation {
  id                String             @id @default(uuid())
  tenantId          String
  channelId         String
  customerPhone     String
  contactId         String?
  assignedAgentId   String?
  assigneeUserId    String?
  status            ConversationStatus @default(OPEN)
  openclawSessionId String?
  lastMessageAt     DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channel       Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  contact       Contact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assignedAgent Agent?            @relation("ConversationAssigneeAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  assignee      User?             @relation("ConversationAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  messages      Message[]
  tags          ConversationTag[]
  approvals     Approval[]        @relation("ApprovalConversation")

  @@unique([tenantId, channelId, customerPhone])
  @@index([tenantId, status])
  @@index([tenantId, assignedAgentId])
  @@index([tenantId, assigneeUserId])
}

model Contact {
  id        String   @id @default(uuid())
  tenantId  String
  phone     String
  name      String?
  email     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([tenantId, phone])
  @@index([tenantId])
}

model Message {
  id             String            @id @default(uuid())
  tenantId       String
  conversationId String
  direction      MessageDirection
  senderType     MessageSenderType
  senderAgentId  String?
  senderUserId   String?
  body           String
  waMessageId    String?
  isInternal     Boolean           @default(false)
  createdAt      DateTime          @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  senderAgent  Agent?       @relation("MessageSenderAgent", fields: [senderAgentId], references: [id], onDelete: SetNull)
  senderUser   User?        @relation("MessageSenderUser", fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, conversationId, createdAt])
}

model Tag {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  color     String?
  createdAt DateTime @default(now())

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations ConversationTag[]

  @@unique([tenantId, name])
}

model ConversationTag {
  id             String @id @default(uuid())
  tenantId       String
  conversationId String
  tagId          String

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tag          Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([conversationId, tagId])
  @@index([tenantId])
  @@index([tagId])
}
