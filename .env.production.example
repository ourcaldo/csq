# Production environment — copy to .env.production and fill in. Never commit secrets.

# Database (pgvector Postgres in the compose stack)
POSTGRES_DB=umkm_prod
POSTGRES_USER=umkm
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql://umkm:change-me-strong-password@postgres:5432/umkm_prod

# Auth
NEXTAUTH_URL=https://your-domain.com
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# WhatsApp Cloud API (v25.0)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v25.0

# Google Sheets OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# OpenClaw sidecar (loopback:18789 inside the compose network)
OPENCLAW_BASE_URL=http://openclaw:18789
OPENCLAW_API_KEY=

# TLS (used by Nginx/Certbot)
CERT_DOMAIN=your-domain.com
EMAIL=you@example.com
