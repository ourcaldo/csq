# ───────────────────────────────────────────────────────────────
# CSQ production environment (VPS / Docker Compose).
# Copy to .env.production and fill in. Never commit the filled file.
# ───────────────────────────────────────────────────────────────

# ── Postgres (runs on the VPS as a compose service; pgvector image) ──
POSTGRES_DB=umkm_prod
POSTGRES_USER=umkm
POSTGRES_PASSWORD=change-me-strong-password
# Prisma connects over the compose network. The app container uses this URL.
DATABASE_URL=postgresql://umkm:change-me-strong-password@postgres:5432/umkm_prod?schema=public
# Direct (unpooled) URL Prisma uses for migrations — same host here.
DATABASE_URL_UNPOOLED=postgresql://umkm:change-me-strong-password@postgres:5432/umkm_prod?schema=public

# ── Auth (NextAuth v4) ──
NEXTAUTH_URL=https://your-domain.example
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# ── TLS ──
CERT_DOMAIN=your-domain.example

# ── WhatsApp Cloud API (official; ToS-safe). Graph API v25.0. ──
# Required only if a store connects the Cloud API channel.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v25.0

# ── Google Sheets (OAuth) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.example/api/import/sheets/callback

# ── OpenClaw (per-tenant cells, PRD §5/§26) ──
# fleet = production: the app runs `openclaw fleet create <slug>` against the
#         host Docker socket to spawn one isolated OpenClaw container per
#         store. Keep this set to `fleet` for the VPS deploy.
OPENCLAW_PROVISIONING=fleet
# Model each OpenClaw agent uses (Fireworks/Qwen serverless). Provide a valid
# Fireworks API key below; the app passes it to each cell's agent at provisioning.
OPENCLAW_AGENT_MODEL=fireworks/accounts/fireworks/models/qwen3p7-plus
# Dev-only fallback (unused in fleet mode); leave blank on the VPS.
OPENCLAW_BASE_URL=
OPENCLAW_API_KEY=
# Fireworks API key used to configure each cell's Fireworks provider. Set this.
FIREWORKS_API_KEY=fw-...
# Fireworks embeddings (Qwen3) for knowledge semantic retrieval — reuses the
# key above. If FIREWORKS_API_KEY is unset, retrieval degrades to keyword search
# and knowledge writes skip embedding generation (with a warning).
FIREWORKS_EMBEDDING_MODEL=fireworks/qwen3-embedding-8b
FIREWORKS_EMBEDDING_DIM=1024
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference
# Cosine similarity threshold for knowledge.search (0-1).
KNOWLEDGE_SIMILARITY_THRESHOLD=0.5
