// Prisma schema - CSQ.
// Multi-tenant from day one: every model carries tenant_id; all queries filter
// server-side by tenantId (Postgres RLS is the second enforcement layer).
//
// pgvector: "KnowledgeEmbedding.embedding" is declared Unsupported("vector")
// because Prisma has no native vector type. The FIRST migration runs
// `CREATE EXTENSION IF NOT EXISTS vector;` and creates the column; a later
// migration alters it to `vector(1024)` (the initially used embedding model;
// dimension, via the `dimensions` param). All vector reads and writes go
// through src/lib/vector.ts only - never raw SQL elsewhere.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ─────────────────────────── Enums ───────────────────────────

enum UserRole {
  OWNER
  STAFF
}
enum TenantStatus {
  ACTIVE
  SUSPENDED
}

// Plan metadata for the monetization roadmap (PRD 13 Phase 5). Manual
// assignment, display-only pricing - no payment processing. Platform
// table: no tenantId. limits is Zod-validated:
// { agentRepliesPerMonth, messagesOutPerMonth, channels } - null = unlimited.
// Plan catalog (PRD 13). Entitlements are explicit columns so the API and UI
// are typed; NULL means unlimited for that dimension. `features` is the
// opt-in premium catalog (see packages/core/src/types/entitlements.ts).
model Plan {
  id                String   @id @default(uuid())
  name              String   @unique
  priceIdr          Int
  aiCreditsPerMonth Int?
  mauLimit          Int?
  staffLimit        Int?
  channelLimit      Int?
  features          String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenants  Tenant[]
  invoices Invoice[]
  requests PlanRequest[]
}

// One row per charged AI unit (PRD 14). Written at the charge point, unique
// per (tenant, source, ref) so retries cannot double charge. The monthly sum
// is the billing truth; Message/ScenarioRunStep are no longer counted.
enum AiCreditSource {
  REPLY
  SCENARIO_MODULE
}

model AiCreditUsage {
  id        String         @id @default(uuid())
  tenantId  String
  source    AiCreditSource
  credits   Int            @default(1)
  refId     String
  note      String?
  createdAt DateTime       @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, source, refId])
  @@index([tenantId, createdAt])
}

// Manual monthly invoice (PRD 14). Plan name is snapshotted so deleting a
// plan never rewrites history. Number comes from the Invoice_number_seq
// Postgres sequence.
enum InvoiceStatus {
  ISSUED
  PAID
  VOID
}

model Invoice {
  id          String        @id @default(uuid())
  tenantId    String
  planId      String?
  planName    String
  number      String        @unique
  periodStart DateTime
  periodEnd   DateTime
  amountIdr   Int
  status      InvoiceStatus @default(ISSUED)
  issuedAt    DateTime      @default(now())
  dueAt       DateTime
  paidAt      DateTime?
  method      String?
  reference   String?
  note        String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan?  @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@unique([tenantId, periodStart])
  @@index([tenantId, status])
  @@index([status, dueAt])
}

// A tenant's upgrade/downgrade intent (PRD 14). No email; the admin billing
// page is the inbox. Only one open request per tenant is enforced in the API.
enum PlanRequestStatus {
  NEW
  CONTACTED
  DONE
  REJECTED
}

model PlanRequest {
  id              String            @id @default(uuid())
  tenantId        String
  requestedPlanId String
  note            String?
  status          PlanRequestStatus @default(NEW)
  handledById     String?
  handledAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestedPlan Plan      @relation(fields: [requestedPlanId], references: [id], onDelete: Restrict)
  handledBy     AdminUser? @relation(fields: [handledById], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([status, createdAt])
}

// COR-5 (PRD 16): SQL-only partial unique index (Prisma cannot express it):
//   CREATE UNIQUE INDEX "PlanRequest_open_tenantId_key"
//     ON "PlanRequest"("tenantId") WHERE "status" IN ('NEW', 'CONTACTED');
// It makes the "one open request" guard race-safe. Applied in migration
// 20261109120000_prd16_remediation, like the D10f SQL-only indexes before it.

// Platform billing configuration (PRD 14). One row, id "singleton". Bank
// details and due/grace days are edited in the admin console, not env.
// Platform table - no tenantId (the documented exception class).
model BillingSetting {
  id                String   @id @default("singleton")
  bankName          String?
  bankAccountNumber String?
  bankAccountHolder String?
  dueDays           Int      @default(7)
  graceDays         Int      @default(7)
  updatedById       String?
  updatedAt         DateTime @updatedAt

  updatedBy AdminUser? @relation("BillingSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

enum AgentType {
  CUSTOMER_SERVICE
}

enum AgentStatus {
  DRAFT
  ACTIVE
  PAUSED
}

enum ChannelType {
  WHATSAPP
}

enum ChannelProvider {
  CLOUD_API
  BAILEYS
}

enum ChannelStatus {
  CONNECTED
  DISCONNECTED
}

enum DataSourceType {
  MANUAL
  EXCEL
  GOOGLE_SHEETS
}

enum DataSourceStatus {
  ACTIVE
  INACTIVE
  ERROR
}

enum InventorySource {
  MANUAL
  EXCEL
  GOOGLE_SHEETS
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum KnowledgeType {
  FAQ
  POLICY
  BUSINESS_INFO
}

enum MemorySource {
  CONVERSATION
  MANUAL
}

enum MemoryImportance {
  LOW
  MEDIUM
  HIGH
}

enum ApprovalStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
}

// Role of a stage in a pipeline. OPENING is the single first stage a new
// conversation lands on; WON and LOST are terminal (deals stop there). A
// pipeline has exactly one of each (enforced by a partial unique index).
enum StageKind {
  OPENING
  WON
  LOST
  NORMAL
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageSenderType {
  CUSTOMER
  AGENT
  HUMAN
  SCENARIO
  CAMPAIGN
}

// How an inbound message's content arrived (D6). TEXT carries a real text
// body (or a media caption) and drives the agent; MEDIA/OTHER are stored for
// the inbox as "[image]"-style placeholders and never run the LLM.
enum MessageKind {
  TEXT
  MEDIA
  OTHER
}

// Scenario = owner/staff-built automation flow (visual drag-and-drop builder).
// A Scenario is the template (graph + trigger); a ScenarioRun is a live
// execution bound to one conversation. See src/lib/scenario-engine.ts.
enum ScenarioStatus {
  DRAFT
  ACTIVE
  PAUSED
}

// Live execution state of a scenario on a conversation. WAITING = paused on a
// Wait node with resumeAt set (node-cron resumes it); COMPLETED/FAILED terminal.
enum ScenarioRunStatus {
  RUNNING
  WAITING
  COMPLETED
  FAILED
}

enum ScenarioTriggerType {
  ON_NEW_CONVERSATION
  ON_PURCHASE
  ON_TAG_ADDED
  ON_SCHEDULE
  ON_NO_REPLY
}

// ─────────────────────────── Models ───────────────────────────

model Tenant {
  id              String       @id @default(uuid())
  name            String
  slug            String       @unique
  status          TenantStatus @default(ACTIVE)
  planId          String?
  settings        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users               User[]
  agents              Agent[]
  channels            Channel[]
  products            Product[]
  inventory           Inventory[]
  orders              Order[]
  knowledge           Knowledge[]
  knowledgeEmbeddings KnowledgeEmbedding[]
  memories            Memory[]
  inventorySnapshots  InventorySnapshot[]
  dataSources         DataSource[]
  auditLogs           AuditLog[]
  approvals           Approval[]
  conversations       Conversation[]
  conversationReads   ConversationRead[]
  contacts            Contact[]
  tags                Tag[]
  categories          Category[]
  contactTags         ContactTag[]
  contactCategories   ContactCategory[]
  messages            Message[]
  orderItems          OrderItem[]
  agentCapabilities   AgentCapability[]
  conversationTags    ConversationTag[]
  sourceRows          SourceRow[]
  pipelines           Pipeline[]
  stages              Stage[]
  deals               Deal[]
  dealStageHistories  DealStageHistory[]
  scenarios           Scenario[]
  scenarioRuns        ScenarioRun[]
  scenarioRunSteps    ScenarioRunStep[]
  campaigns           Campaign[]
  campaignRuns        CampaignRun[]
  campaignMessages    CampaignMessage[]
  mediaAssets         MediaAsset[]
  credentials         TenantCredential[]
  outboundMessages    OutboundMessage[]
  channelCommands     ChannelCommand[]
  apiKeys             ApiKey[]
  refreshTokens       RefreshToken[]
  aiCreditUsage       AiCreditUsage[]
  invoices            Invoice[]
  planRequests        PlanRequest[]
  refunds             Refund[]
  supportTickets      SupportTicket[]
  teamInvites         TeamInvite[]
  syncLogs            SyncLog[]
  plan                Plan?             @relation(fields: [planId], references: [id], onDelete: SetNull)
}

// D10c: per-tenant external OAuth credentials, SEPARATE from Tenant.settings.
// Tokens are secrets; settings is a config blob several routes read-merge-write,
// so keeping tokens there made any future `select settings` a credential leak.
// Only src/lib/google-connect.ts reads this table. The legacy googleSheets key
// that lived in Tenant.settings was copied here by migration
// 20261101000600 and dropped by migration 20261101000900.
model TenantCredential {
  id           String    @id @default(uuid())
  tenantId     String
  provider     String    @default("google")
  accessToken  String
  refreshToken String?
  expiryDate   DateTime?
  email        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
  @@index([tenantId])
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  name            String?
  passwordHash    String
  role            UserRole @default(OWNER)
  tenantId        String
  // Campaign permission (feature plan 2026-11-01, decision 2.2): OWNER may
  // always run campaigns; STAFF may create/pause them only when the owner
  // grants this per-staff toggle from the Team page.
  canRunCampaigns Boolean  @default(false)
  // FEA-5 (PRD 16): invite-token accounts must set their own password at
  // first login; the invite credential is single-use.
  mustChangePassword Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant                Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedConversations Conversation[]     @relation("ConversationAssignee")
  sentMessages          Message[]          @relation("MessageSenderUser")
  resolvedApprovals     Approval[]         @relation("ApprovalResolver")
  conversationReads     ConversationRead[]
  teamInvitesSent       TeamInvite[]       @relation("TeamInviteInviter")

  @@index([tenantId])
}

model Agent {
  id              String      @id @default(uuid())
  tenantId        String
  name            String
  type            AgentType   @default(CUSTOMER_SERVICE)
  status          AgentStatus @default(DRAFT)
  instructions    String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  tenant                Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channels              Channel[]
  capabilities          AgentCapability[]
  memories              Memory[]
  auditLogs             AuditLog[]
  approvals             Approval[]
  createdOrders         Order[]           @relation("OrderCreatedByAgent")
  assignedConversations Conversation[]    @relation("ConversationAssigneeAgent")
  sentMessages          Message[]         @relation("MessageSenderAgent")

  @@index([tenantId])
}

model Channel {
  id        String          @id @default(uuid())
  tenantId  String
  agentId   String?
  type      ChannelType     @default(WHATSAPP)
  provider  ChannelProvider @default(CLOUD_API)
  config    Json
  status    ChannelStatus   @default(DISCONNECTED)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent         Agent?         @relation(fields: [agentId], references: [id], onDelete: SetNull)
  conversations Conversation[]
  outbox        OutboundMessage[]
  commands      ChannelCommand[]

  @@index([tenantId])
}

// Baileys (bring-your-own-number) auth state, stored in the DB so it
// survives restarts without a persistent disk (PRD: always-on, no re-pair
// on restart). Keyed by channelId. creds/keys are the BufferJSON-serialized
// auth state (see src/lib/baileys-auth-db.ts).
model BaileysAuth {
  channelId String   @id
  creds     String?
  keys      String?
  updatedAt DateTime @updatedAt
}

// LID -> phone-number mapping for Baileys channels. Sends to a raw
// "<lid>@lid" JID are accepted by WhatsApp but never delivered on Baileys
// 6.7.x (WhiskeySockets/Baileys#1950, #1964 - the fix landed in v7 only).
// Inbound messages carry the sender's real number (key.senderPn); it is
// captured here so outbound sends and the dashboard resolve the real phone
// number. Keyed by channel: the LID rotates on every device re-pair.
model LidMapping {
  channelId String
  lid       String
  pn        String
  updatedAt DateTime @updatedAt

  @@id([channelId, lid])
}

// ─────────────── Enterprise worker queue (PRD 23C, Phase 6) ───────────────
// The dashboard no longer owns WhatsApp sockets: sends it initiates become
// OutboundMessage rows a worker drains, and connect/QR/disconnect become
// ChannelCommand rows the worker executes. Same Postgres-as-queue pattern as
// CampaignMessage - no Redis (stack constraint). See
// docs/plans/2026-11-08-enterprise-architecture-plan.md section 4.

enum OutboundSource {
  REPLY
  TEST
  TEMPLATE_SEND
}

enum OutboundStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  CANCELLED
}

enum ChannelCommandKind {
  CONNECT
  DISCONNECT
}

enum ChannelCommandStatus {
  PENDING
  DONE
  FAILED
}

// One outbound send request. `body` for free-form text, `templateName` +
// `language` for template sends (one of the two is set). `toJid` is the
// destination exactly as the caller resolved it (conversation customerPhone
// or the test number) - the worker's provider layer does the final JID
// normalization. `waMessageId`/`sentAt` are written on success, `error` on
// failure. CANCELLED is set by a caller that gave up waiting while the row
// was still QUEUED (worker down); a row already SENDING may still deliver.
model OutboundMessage {
  id           String         @id @default(uuid())
  tenantId     String
  channelId    String
  toJid        String
  body         String?
  templateName String?
  language     String?
  source       OutboundSource
  status       OutboundStatus @default(QUEUED)
  waMessageId  String?
  error        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sentAt       DateTime?

  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channel  Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([tenantId])
}

// One dashboard-requested channel operation for the worker. CONNECT: the
// worker runs the Baileys pairing and streams the rotating QR into `result`
// ({ qr, open, closeCode }) while pending, then finalizes DONE (QR obtained
// or socket open) or FAILED (e.g. fatal 401). DISCONNECT: the worker logs
// out the device, tears down the socket, and clears creds. The dashboard
// routes poll the row until terminal status.
model ChannelCommand {
  id         String              @id @default(uuid())
  tenantId   String
  channelId  String
  kind       ChannelCommandKind
  status     ChannelCommandStatus @default(PENDING)
  result     Json?
  error      String?
  requestedBy String
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channel  Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([tenantId])
}

// Tenant API key for the /api/v1 surface (PRD 23C Phase 7). The plaintext
// token is shown exactly once at mint time; only the sha256 hash is stored.
// `prefix` (first chars of the token) identifies the key in the UI without
// exposing it. Revocation is soft (revokedAt) - audit history stays intact.
model ApiKey {
  id         String    @id @default(uuid())
  tenantId   String
  name       String
  tokenHash  String    @unique
  prefix     String    @unique
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// Mobile auth realm (PRD 23C Phase 8): the server-side half of the
// /api/v1/auth token exchange. Opaque refresh tokens, sha256-hashed, rotated
// on every refresh, revocable on logout. Access tokens are stateless JWTs
// and deliberately have no row here.
model RefreshToken {
  id        String    @id @default(uuid())
  tenantId  String
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
}

// ─────────── Platform admin realm (PRD 13, file 13) ───────────
// The operator console's users. SEPARATE from tenant users on purpose: an
// operator credential can never resolve to a tenant session and vice versa
// (different table, different auth provider, different cookie secret).
// Platform table - no tenantId (the documented exception class).

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  // SEC-5 (PRD 16): realm role. Single value today; the column exists so
  // adding operators never needs a second migration.
  role         String   @default("SUPERADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  actions AdminActionLog[]
  handledPlanRequests PlanRequest[]
  billingSettingsUpdated BillingSetting[] @relation("BillingSettingUpdatedBy")
}

// Every operator mutation, audited with actor + before/after (PRD 13).
// Platform table - no tenantId.
model AdminActionLog {
  id          String    @id @default(uuid())
  adminId     String
  action      String
  targetType  String
  targetId    String?
  beforeValue Json?
  afterValue  Json?
  createdAt   DateTime  @default(now())

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([createdAt])
}

model Product {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  sku         String?
  price       Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventory          Inventory?
  orderItems         OrderItem[]
  inventorySnapshots InventorySnapshot[]

  // M13: (tenantId, sku) is unique so SKU lookups have a uniqueness guarantee
  // and imports can't create duplicate-SKU products for a tenant. NULL skus are
  // allowed (Postgres treats NULLs as distinct in a UNIQUE index).
  @@unique([tenantId, sku])
  @@index([tenantId, name])
}

model Inventory {
  id        String          @id @default(uuid())
  tenantId  String
  productId String          @unique
  quantity  Int
  source    InventorySource @default(MANUAL)
  sourceRef String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([tenantId, productId])
  @@index([tenantId])
}

// G8: per-source stock snapshot so Tenant.settings.sourcePriority can
// arbitrate conflicts between sources. One row per (tenant, product, source).
// The canonical Inventory row holds the resolved quantity; snapshots hold each
// source's contribution. Resolution lives in src/lib/source-priority.ts.
model InventorySnapshot {
  id        String          @id @default(uuid())
  tenantId  String
  productId String
  source    InventorySource
  quantity  Int
  sourceRef String?
  // FEA-8 (PRD 16): data-authority confidence for this observation
  // (0-1). Defaults to 1.0; ingestion may lower it for fuzzy matches.
  confidence Float         @default(1)
  syncedAt  DateTime        @default(now())
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([tenantId, productId, source])
  @@index([tenantId, productId])
}

model Order {
  id               String      @id @default(uuid())
  tenantId         String
  customerName     String?
  customerPhone    String?
  status           OrderStatus @default(PENDING)
  totalAmount      Decimal     @db.Decimal(14, 2)
  createdByAgentId String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdByAgent Agent?      @relation("OrderCreatedByAgent", fields: [createdByAgentId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  refunds        Refund[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model OrderItem {
  id        String  @id @default(uuid())
  tenantId  String
  orderId   String
  productId String
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  subtotal  Decimal @db.Decimal(14, 2)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([tenantId])
  @@index([orderId])
  @@index([productId])
}

model Knowledge {
  id         String        @id @default(uuid())
  tenantId    String
  type        KnowledgeType
  title       String
  content     String
  // FEA-1 (PRD 16): provenance for uploaded documents (PDF/DOCX). Manual
  // entries leave both null.
  sourceName  String?
  mimeType    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  embedding KnowledgeEmbedding?

  @@index([tenantId, type])
}

model KnowledgeEmbedding {
  id          String                 @id @default(uuid())
  tenantId    String
  knowledgeId String                 @unique
  embedding   Unsupported("vector")?
  createdAt   DateTime               @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  knowledge Knowledge @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Memory {
  id         String           @id @default(uuid())
  tenantId   String
  agentId    String
  key        String
  value      String
  source     MemorySource     @default(CONVERSATION)
  importance MemoryImportance @default(MEDIUM)
  createdAt  DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent  Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, agentId, key])
  @@index([tenantId, agentId])
}

model DataSource {
  id         String           @id @default(uuid())
  tenantId   String
  type       DataSourceType
  name       String
  // What kind of data this source holds, e.g. "produk", "cabang", "staff",
  // or a free label. Only "produk" gets structured import into Product/
  // Inventory; everything else is reference data the agent reads via
  // source.search (all columns). Free string so owners can tag any kind of list.
  dataType   String           @default("produk")
  config     Json
  status     DataSourceStatus @default(ACTIVE)
  lastSyncAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceRows SourceRow[]
  syncLogs   SyncLog[]

  @@index([tenantId])
}

// Full parsed rows from an Excel/Google Sheets source, stored on import and on
// each sync so the agent can read inside the sumber data via the `source.search`
// tool - every column, not just the five mapped product fields. Replaced (delete
// + re-insert) on every sync so it stays in sync with the source. `data` is the
// row as { column: value }.
model SourceRow {
  id           String   @id @default(uuid())
  tenantId     String
  dataSourceId String
  rowIndex     Int
  data         Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dataSource DataSource @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)

  @@index([tenantId, dataSourceId])
}

model AgentCapability {
  id               String  @id @default(uuid())
  tenantId         String
  agentId          String
  tool             String
  allowed          Boolean @default(false)
  requiresApproval Boolean @default(false)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent  Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, tool])
  @@index([tenantId])
}

model AuditLog {
  id             String         @id @default(uuid())
  tenantId       String
  agentId        String?
  action         String
  entityType     String
  entityId       String
  beforeValue    Json?
  afterValue     Json?
  approvalStatus ApprovalStatus @default(NONE)
  customerPhone  String?
  createdAt      DateTime       @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent  Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, agentId])
}

model Approval {
  id             String         @id @default(uuid())
  tenantId       String
  agentId        String?
  action         String
  entityType     String
  entityId       String
  proposedBefore Json
  proposedAfter  Json
  params         Json?
  status         ApprovalStatus @default(PENDING)
  resolvedById   String?
  resolvedAt     DateTime?
  createdAt      DateTime       @default(now())
  // G1: routing context so the approval result can be sent back to the
  // originating customer conversation once the owner resolves it.
  conversationId String?
  channelId      String?
  customerPhone  String?

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent        Agent?        @relation(fields: [agentId], references: [id], onDelete: SetNull)
  resolvedBy   User?         @relation("ApprovalResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  conversation Conversation? @relation("ApprovalConversation", fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([conversationId])
}

model Conversation {
  id                String             @id @default(uuid())
  tenantId          String
  channelId         String
  customerPhone     String
  contactId         String?
  assignedAgentId   String?
  assigneeUserId    String?
  status            ConversationStatus @default(OPEN)
  lastMessageAt     DateTime?
  // System flags per conversation (JSON). Currently: session-close tracking
  // (sessionClosedAt, lastInboundClosedAt) so the idle-1h close message is
  // sent at most once per agent-session window.
  settings          Json?
  // D1: per-conversation turn lease. Replaces the transaction-held advisory
  // lock so no pooled connection is pinned across LLM HTTP latency. All
  // reads/writes go through src/lib/turn-lock.ts only.
  turnLockId        String?
  turnLockedAt      DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channel       Channel            @relation(fields: [channelId], references: [id], onDelete: Cascade)
  contact       Contact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assignedAgent Agent?             @relation("ConversationAssigneeAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  assignee      User?              @relation("ConversationAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  messages      Message[]
  tags          ConversationTag[]
  approvals     Approval[]         @relation("ApprovalConversation")
  deal          Deal?
  scenarioRuns  ScenarioRun[]
  reads         ConversationRead[]

  @@unique([tenantId, channelId, customerPhone])
  @@index([tenantId, status])
  @@index([tenantId, assignedAgentId])
  @@index([tenantId, assigneeUserId])
}

// Per-user "chat opened" watermark for the inbox unread badge (WhatsApp-style:
// badge shows when an INBOUND message arrived after this user last opened the
// conversation; opening the chat clears it).
model ConversationRead {
  id             String   @id @default(uuid())
  conversationId String
  userId         String
  tenantId       String
  lastReadAt     DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([tenantId])
}

model Contact {
  id        String   @id @default(uuid())
  tenantId  String
  phone     String
  name      String?
  email     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations  Conversation[]
  categories     ContactCategory[]
  tags           ContactTag[]

  @@unique([tenantId, phone])
  @@index([tenantId])
}

model Message {
  id             String            @id @default(uuid())
  tenantId       String
  conversationId String
  direction      MessageDirection
  senderType     MessageSenderType
  senderAgentId  String?
  senderUserId   String?
  body           String
  waMessageId    String?
  kind           MessageKind       @default(TEXT)
  // Outbound media reference (campaign image sends). The bytes live in
  // MediaAsset and are served by apps/api at /api/media/[id]; the inbox
  // renders this as an image instead of a text placeholder.
  mediaId        String?
  isInternal     Boolean           @default(false)
  createdAt      DateTime          @default(now())

  // D3: a PARTIAL unique index exists in Postgres on (tenantId, waMessageId)
  // WHERE waMessageId IS NOT NULL (migration 20261101000100). Prisma cannot
  // express partial unique indexes, so it is not declared here; the P2002
  // catch in src/lib/inbox.ts recordInboundMessage is what makes redeliveries
  // idempotent. Do not add a plain @@unique([tenantId, waMessageId]) here.

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  senderAgent  Agent?       @relation("MessageSenderAgent", fields: [senderAgentId], references: [id], onDelete: SetNull)
  senderUser   User?        @relation("MessageSenderUser", fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, conversationId, createdAt])
}

model Tag {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  color     String?
  createdAt DateTime @default(now())

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations ConversationTag[]
  contacts      ContactTag[]

  @@unique([tenantId, name])
}

// Contact classification taxonomy, the same pattern as Tag (feature plan
// 2026-11-01, section 2). Tenant-scoped list of categories ("Reseller",
// "VIP", "Grosir"); a contact may belong to MULTIPLE categories via the
// ContactCategory join, exactly like tags.
model Category {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts ContactCategory[]

  @@unique([tenantId, name])
}

model ContactTag {
  id        String  @id @default(uuid())
  tenantId  String
  contactId String
  tagId     String

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([contactId, tagId])
  @@index([tenantId, tagId])
}

model ContactCategory {
  id         String  @id @default(uuid())
  tenantId   String
  contactId  String
  categoryId String

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([contactId, categoryId])
  @@index([tenantId, categoryId])
}

model ConversationTag {
  id             String @id @default(uuid())
  tenantId       String
  conversationId String
  tagId          String

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tag          Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([conversationId, tagId])
  @@index([tenantId])
  @@index([tagId])
}

// Sales pipeline for a tenant - one per tenant. Lazily seeded from the default
// template the first time the owner opens the Pipeline page.
model Pipeline {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stages Stage[]

  // D10b: exactly one pipeline per tenant, enforced by the database. The old
  // plain index was replaced by this unique constraint (migration
  // 20261101000500_pipeline_unique); getOrCreatePipeline relies on it for its
  // race-free upsert.
  @@unique([tenantId])
}

// A stage in a tenant's pipeline. `order` is the kanban column order. `kind`
// marks the role: OPENING (the single entry stage), WON/LOST (terminal), NORMAL
// (intermediate). winProbability (0..1) and expectedDays are optional per stage
// and power the funnel/stuck-deal views. A pipeline has exactly one OPENING,
// one WON, one LOST - enforced by a partial unique index in the migration
// (Prisma schema can't express filtered uniques); the app also enforces it.
model Stage {
  id             String    @id @default(uuid())
  tenantId       String
  pipelineId     String
  name           String
  order          Int
  winProbability Float?
  expectedDays   Int?
  kind           StageKind
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@index([pipelineId, order])
  @@index([pipelineId, kind])
  @@index([tenantId])
}

// A deal is a conversation being worked through the pipeline. 1:1 with
// Conversation; `stageId` is the current stage. Created lazily the first time a
// conversation is placed on a stage (by the AI agent or a human).
model Deal {
  id             String   @id @default(uuid())
  tenantId       String
  conversationId String   @unique
  stageId        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  stage        Stage              @relation(fields: [stageId], references: [id], onDelete: Restrict)
  histories    DealStageHistory[]

  @@index([tenantId, stageId])
}

// Audit trail of stage transitions - one row per move. `movedByUserId` for a
// human move, `movedByAgentId` for an AI auto-move; at least one is set.
model DealStageHistory {
  id             String   @id @default(uuid())
  tenantId       String
  dealId         String
  fromStageId    String
  toStageId      String
  movedByUserId  String?
  movedByAgentId String?
  reason         String?
  createdAt      DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([tenantId, dealId, createdAt])
}

// ─────────────────────────── System lock ───────────────────────────

// D10d: cross-instance cron mutual exclusion. startScheduler() boots from the
// health endpoint on EVERY instance, so a second instance would duplicate
// Sheets syncs, scenario runs, and session-close messages. A lock row with a
// TTL is a lease, not a mutex held forever: a crashed tick self-heals when
// its TTL expires. See src/lib/system-lock.ts.
model SystemLock {
  key         String   @id
  token       String
  lockedUntil DateTime
  updatedAt   DateTime @updatedAt
}

// ─────────────────────────── Campaigns ───────────────────────────
// Message blasting (feature plan 2026-11-01, section 3). A campaign targets
// an audience (all contacts / categories / tags / a manual list), carries a
// content SNAPSHOT resolved at save time, and fires on a schedule with a
// pacing delay between contacts. Each fire creates a CampaignRun plus one
// CampaignMessage row per recipient with its own scheduledFor - the minute
// tick drains them, so a blast survives restarts and never double-sends.

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum CampaignAudience {
  ALL
  CATEGORY
  TAGS
  MANUAL
}

// Schedule kinds (owner round 1: once, daily, weekly, monthly, "other" = every
// N days). Times are interpreted in SCENARIO_SCHEDULE_TZ. Config shape is
// validated by Zod in src/types/campaign.ts.
enum CampaignScheduleKind {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
  INTERVAL
}

// BODY = free-form internal template / typed text (plus optional images);
// deliverable on Cloud API only inside the 24h window. META_TEMPLATE = a
// pre-approved Meta template name (with a snapshot body for Baileys) - the
// only content that reaches out-of-window recipients on Cloud API.
enum CampaignSendKind {
  BODY
  META_TEMPLATE
}

enum CampaignMessageStatus {
  PENDING
  // COR-1 (PRD 16): claimed by a tick, in flight. Reset to PENDING at tick
  // start when stale so a crash between claim and send cannot double-send.
  SENDING
  SENT
  FAILED
  SKIPPED
}

model MediaAsset {
  id        String   @id @default(uuid())
  tenantId  String
  mimeType  String
  byteSize  Int
  // Postgres bytea - the app has no S3 and the deploy disk is wiped, so the
  // database is the only durable store. Served publicly (immutable cache) via
  // /api/media/[id] so Meta's fetcher can reach it; UUID ids are the access
  // control (owner round-2 decision, plan section 3.2.1).
  data      Bytes
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

model Campaign {
  id            String               @id @default(uuid())
  tenantId      String
  // Plain scalar, not a relation: a deleted channel leaves a campaign that
  // fails its fire-time channel check instead of cascading away history.
  channelId     String
  name          String
  status        CampaignStatus      @default(DRAFT)
  // Audience. CATEGORY/TAGS resolve FRESH at every fire (round-1 decision);
  // MANUAL is the stored snapshot.
  audience      CampaignAudience
  categoryIds   String[]            @default([])
  tagIds        String[]            @default([])
  contactIds    String[]             @default([])
  // Content snapshot (resolved at save time so later template edits never
  // silently change a scheduled campaign).
  sendKind      CampaignSendKind
  body          String
  imageIds      String[]            @default([])
  metaName      String?
  metaLanguage  String?
  // Schedule (plan section 3.4). delaySeconds paces contacts apart.
  scheduleKind  CampaignScheduleKind
  scheduleConfig Json               @default("{}")
  delaySeconds  Int                 @default(30)
  nextRunAt     DateTime?
  lastRunAt     DateTime?
  // SEC-4 (PRD 16): true when tenant suspension moved this campaign from
  // ACTIVE to PAUSED, so activation can resume exactly those.
  autoPaused    Boolean             @default(false)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runs   CampaignRun[]

  @@index([tenantId, status, nextRunAt])
}

// One fire of one campaign.
model CampaignRun {
  id         String    @id @default(uuid())
  tenantId   String
  campaignId String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  // {total,sent,failed,skipped} - stamped when no PENDING rows remain.
  counts     Json?

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  messages CampaignMessage[]

  @@index([tenantId, campaignId, startedAt])
}

// Per recipient per fire - the pacing and resume log. scheduledFor spreads
// the blast; the minute tick sends the due ones (bounded).
model CampaignMessage {
  id           String                @id @default(uuid())
  tenantId     String
  runId        String
  contactId    String
  phone        String
  status       CampaignMessageStatus @default(PENDING)
  scheduledFor DateTime
  sentAt       DateTime?
  waMessageId  String?
  reason       String?

  run    CampaignRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([runId, status, scheduledFor])
  @@index([tenantId, runId])
}

// ─────────────────────────── Scenarios ───────────────────────────
// Scenario automation: a visual drag-and-drop flow the owner/staff builds.
// Fire-and-forget outbound sequences (surveys, after-sales) - the scenario
// injects messages at trigger times and never owns the conversation; the AI
// agent handles any reply as normal. Channel-agnostic; on Cloud API no send
// may land past the 24h customer-service window (enforced at runtime +
// warned at validate time). See src/lib/scenario-engine.ts.

// The template: a graph (nodes + edges, React Flow shape) + trigger contract.
// triggerType is a column so the engine can find active scenarios for an event
// without parsing the JSON graph. triggerConfig holds type-specific bits
// (e.g. { tagName } for ON_TAG_ADDED), Zod-validated at the API boundary.
model Scenario {
  id            String              @id @default(uuid())
  tenantId      String
  name          String
  description   String?
  status        ScenarioStatus      @default(DRAFT)
  triggerType   ScenarioTriggerType
  triggerConfig Json                @default("{}")
  // { nodes: ScenarioNode[], edges: ScenarioEdge[] } - validated by Zod in
  // src/types/scenario.ts, never trusted raw. Stored as Json so the builder
  // can evolve node shapes without a migration.
  graph         Json                @default("{}")
  version       Int                 @default(1)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runs   ScenarioRun[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, triggerType, status])
}

// A live execution of a Scenario bound to one conversation. `context` is the
// variable payload from the trigger event (customer_name, order_id, ...) that
// `{{variable}}` interpolation in Send nodes resolves against. `currentNodeId`
// is the next node to execute. `resumeAt` is set when WAITING on a Wait node;
// node-cron resumes due runs. `dedupKey` (+ scenarioId) makes trigger firing
// idempotent - a redelivered webhook or double-fire cannot start a duplicate.
model ScenarioRun {
  id             String            @id @default(uuid())
  tenantId       String
  scenarioId     String
  conversationId String
  status         ScenarioRunStatus @default(RUNNING)
  currentNodeId  String?
  context        Json              @default("{}")
  resumeAt       DateTime?
  // Idempotency: scenarioId + dedupKey unique. dedupKey is the trigger ref
  // (order id, conversation id, message id) so the same event never starts two
  // runs of the same scenario.
  dedupKey       String            @default("")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scenario     Scenario          @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  steps        ScenarioRunStep[]

  @@unique([scenarioId, dedupKey])
  @@index([tenantId, status])
  @@index([status, resumeAt])
  @@index([conversationId])
}

// Per-node execution audit: one row per node the run executes. Append-only
// (the engine only creates). `result` carries node-specific output (sent
// message id, branch taken, tag applied) for traceability.
model ScenarioRunStep {
  id          String            @id @default(uuid())
  tenantId    String
  runId       String
  nodeId      String
  nodeType    String
  status      ScenarioRunStatus
  result      Json?
  error       String?
  startedAt   DateTime          @default(now())
  completedAt DateTime?

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  run    ScenarioRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([tenantId, runId, startedAt])
}

// ──────────────────── PRD 16 additions ────────────────────

// FEA-2 (PRD 16): a recorded refund request on an order. Approval-gated:
// the order.refund tool is allowed=false + requiresApproval=true, so a
// customer request can never move money or data on its own. Record-only -
// no payment-gateway integration (PRD 16 non-goal).
enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
}

model Refund {
  id                 String       @id @default(uuid())
  tenantId           String
  orderId            String
  amount             Decimal      @db.Decimal(14, 2)
  reason             String?
  status             RefundStatus @default(PENDING)
  // Plain scalars (Campaign.channelId pattern): the creating agent and the
  // resolving user are recorded for audit without cross-model cascade rules.
  createdByAgentId   String?
  resolvedById       String?
  resolvedAt         DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([orderId])
}

// FEA-3 (PRD 16): a support ticket the agent opens for a customer issue
// that needs a human beyond the conversation itself (PRD 03 section 17).
enum SupportTicketStatus {
  OPEN
  RESOLVED
}

model SupportTicket {
  id               String              @id @default(uuid())
  tenantId         String
  conversationId   String?
  contactPhone     String?
  subject          String
  body             String
  status           SupportTicketStatus @default(OPEN)
  createdByAgentId String?
  resolvedById     String?
  resolvedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

// FEA-5 (PRD 16): one-time staff invite. The dashboard shows nothing; the
// emailed link carries a raw token whose SHA-256 hash is stored here. The
// set-password page consumes the token once and creates the User with
// mustChangePassword=false (the password IS the user's choice).
model TeamInvite {
  id         String    @id @default(uuid())
  tenantId   String
  email      String
  tokenHash  String    @unique
  role       UserRole  @default(STAFF)
  expiresAt  DateTime
  acceptedAt DateTime?
  invitedById String
  createdAt  DateTime  @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy User   @relation("TeamInviteInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([email])
}

// FEA-7 (PRD 16): one row per source sync so the sources page can show
// history, not just lastSyncAt. Written by the same code that performs the
// sync; never updated after creation.
enum SyncLogStatus {
  SUCCESS
  PARTIAL
  FAILED
}

model SyncLog {
  id           String        @id @default(uuid())
  tenantId     String
  dataSourceId String
  status       SyncLogStatus
  rowsCreated  Int           @default(0)
  rowsUpdated  Int           @default(0)
  rowsSkipped  Int           @default(0)
  message      String?
  createdAt    DateTime      @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dataSource DataSource @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)

  @@index([tenantId, dataSourceId, createdAt])
}
