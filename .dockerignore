# Environment files - never bake secrets into the image
.env
.env.*

# Baileys auth state - runtime only (the worker stores auth in Postgres)
.baileys-auth/

# Build artifacts and dependencies (installed fresh inside the container)
node_modules/
.next/
*.tsbuildinfo

# Git history
.git/

# Docker config and setup scripts are not needed inside the app image
docker/

# Documentation and planning files
docs/
plans/
.claude/
