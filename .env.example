# Database (pgvector-enabled Postgres). Dev: pgvector/pgvector:pg16 via docker-compose.dev.yml.
# DATABASE_URL is the pooled connection (app runtime). DATABASE_URL_UNPOOLED is
# the direct connection Prisma uses for migrations (schema.prisma directUrl).
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Auth (NextAuth v4)
NEXTAUTH_URL=
NEXTAUTH_SECRET=

# WhatsApp Cloud API (official; ToS-safe). Graph API v25.0.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v25.0

# Google Sheets (OAuth). Create a Google Cloud OAuth 2.0 Client ID (Web app),
# enable the Google Sheets API + Google Drive API, and register the redirect
# URI below in the Console. Drive API is required to list the user's sheets.
# Redirect URIs to register (dev + prod):
#   http://localhost:3000/api/import/sheets/callback
#   https://<your-render-domain>/api/import/sheets/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# OpenClaw — agent runtime. Each tenant gets an isolated cell (PRD §5/§26).
# OPENCLAW_PROVISIONING selects the backend:
#   fleet  = production (VPS): `openclaw fleet create <slug>` spawns one
#            hardened Gateway container per store. Per-tenant cells are
#            stored on the Tenant row at provisioning time.
#   shared = dev only: all tenants share one gateway (below) and target its
#            `default` agent. NOT a tenant isolation boundary.
OPENCLAW_PROVISIONING=shared
# Default model each OpenClaw agent uses (Fireworks/Qwen serverless).
OPENCLAW_AGENT_MODEL=fireworks/accounts/fireworks/models/qwen3p7-plus

# Used only when OPENCLAW_PROVISIONING=shared (dev), and as a fallback when a
# tenant has no provisioned cell yet. HTTP OpenAI-compatible API.
OPENCLAW_BASE_URL=http://127.0.0.1:18789
OPENCLAW_API_KEY=

# Fireworks embeddings (Qwen3) for knowledge semantic retrieval. Reuses the
# same Fireworks account/key as the OpenClaw cell provider. Required for
# knowledge.search semantic retrieval; if unset, retrieval degrades to keyword
# search and knowledge writes skip embedding generation (with a warning).
FIREWORKS_API_KEY=
FIREWORKS_EMBEDDING_MODEL=fireworks/qwen3-embedding-8b
FIREWORKS_EMBEDDING_DIM=1024
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference
# Cosine similarity threshold for knowledge.search (0-1). Qwen3 similarities on
# Indonesian short-text cluster lower than the old OpenAI default; tune down if
# relevant results are missed, up if false positives appear.
KNOWLEDGE_SIMILARITY_THRESHOLD=0.5

# WhatsApp Cloud API approved templates (G7/G1) — required to message a customer
# outside the 24h customer-service window. Pre-approve them in Meta Business
# Manager and set the exact template names here. When unset and a send falls
# outside the 24h window, the send is skipped + audited (Meta-compliant).
WHATSAPP_APPROVAL_TEMPLATE=
WHATSAPP_AGENT_FALLBACK_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=id

