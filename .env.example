# Database (pgvector-enabled Postgres). Dev: pgvector/pgvector:pg16 via docker-compose.dev.yml.
DATABASE_URL=

# Auth (NextAuth v4)
NEXTAUTH_URL=
NEXTAUTH_SECRET=

# WhatsApp Cloud API (official; ToS-safe). Graph API v25.0.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v25.0

# Google Sheets (OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# OpenClaw — self-hosted Gateway sidecar. HTTP OpenAI-compatible API on loopback port 18789.
# (Integration validated: client-side function tools; our /api/tools/* is the tool executor.)
OPENCLAW_BASE_URL=http://127.0.0.1:18789
OPENCLAW_API_KEY=
